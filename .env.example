# Copy to .env and fill in. .env is gitignored and must never be committed.

# The SEC requires a declared contact in the User-Agent header.
# A missing or empty User-Agent returns HTTP 403.
# Format: "Organisation Name contact@example.com"
SEC_USER_AGENT=Research Project research@example.com

# Which model the language model half runs. Served by Vertex AI; whichever
# id is used is written onto every output row.
FILINGBENCH_MODEL=google/gemini-2.5-flash-lite

# Vertex AI. No static key: it authenticates with a short lived token from the
# gcloud CLI, so the machine needs `gcloud auth login` already done. The rules
# half runs without either of these.
GCP_PROJECT_ID=your-gcp-project
GCP_REGION=us-central1
